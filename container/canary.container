[Unit]
Description=Canary — сетевые ловушки (GELF в Graylog)
After=network-online.target

[Container]
Image=localhost/canary:latest
ContainerName=canary
PublishPort=445:445
PublishPort=1433:1433
PublishPort=3306:3306
PublishPort=5900:5900
PublishPort=2323:2323
PublishPort=8081:8081
PublishPort=6379:6379
PublishPort=11211:11211
PublishPort=2375:2375
Volume=%h/canary/data:/data:Z
Environment=GELF_HOST=host.containers.internal
Environment=GELF_PORT=12206

[Service]
Restart=always
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=default.target
